# Copy to .env and adjust as needed.

# Server
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000
CLIPFORGE_LOG_LEVEL=INFO

# Where project data (media, transcripts, clips, exports) is stored
CLIPFORGE_DATA_DIR=./data

# Frontend origin allowed to call this API (CORS)
CLIPFORGE_FRONTEND_ORIGIN=http://localhost:5173

# Local AI
CLIPFORGE_OLLAMA_HOST=http://localhost:11434
CLIPFORGE_OLLAMA_MODEL=llama3.1
CLIPFORGE_WHISPER_MODEL_SIZE=base
CLIPFORGE_QUALITY_MODE=balanced
